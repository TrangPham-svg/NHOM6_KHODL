            <component
              refId="Package\DFT_Dim_Date\SRC_Staging_Dates"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
              description="OLE DB Source"
              name="SRC_Staging_Dates"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">WITH ArrivalDates AS
(
    SELECT DISTINCT
        DATEFROMPARTS(
            arrival_date_year,
            CASE arrival_date_month
                WHEN 'January' THEN 1
                WHEN 'February' THEN 2
                WHEN 'March' THEN 3
                WHEN 'April' THEN 4
                WHEN 'May' THEN 5
                WHEN 'June' THEN 6
                WHEN 'July' THEN 7
                WHEN 'August' THEN 8
                WHEN 'September' THEN 9
                WHEN 'October' THEN 10
                WHEN 'November' THEN 11
                WHEN 'December' THEN 12
            END,
            arrival_date_day_of_month
        ) AS full_date
    FROM dbo.Staging_Bookings
    WHERE arrival_date_year IS NOT NULL
      AND arrival_date_month IS NOT NULL
      AND arrival_date_day_of_month IS NOT NULL
),
StatusDates AS
(
    SELECT DISTINCT
        TRY_CONVERT(DATE, reservation_status_date) AS full_date
    FROM dbo.Staging_Bookings
    WHERE reservation_status_date IS NOT NULL
),
AllDates AS
(
    SELECT full_date
    FROM ArrivalDates
    WHERE full_date IS NOT NULL

    UNION

    SELECT full_date
    FROM StatusDates
    WHERE full_date IS NOT NULL
)
SELECT
    CONVERT(INT, CONVERT(CHAR(8), full_date, 112)) AS date_key,
    full_date,
    YEAR(full_date) AS year,
    MONTH(full_date) AS month,
    DATEPART(ISO_WEEK, full_date) AS week_number,
    DAY(full_date) AS day_of_month,
    DATENAME(MONTH, full_date) AS month_name,
    DATEPART(QUARTER, full_date) AS quarter
FROM AllDates
ORDER BY full_date;</property>
                <property
