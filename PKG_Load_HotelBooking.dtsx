    TRY_CAST(SUBSTRING(LTRIM(RTRIM(agent)), 3, 20) AS INT) AS AgentID
FROM HotelBooking_Staging.dbo.Staging_Bookings
WHERE agent IS NOT NULL
  AND UPPER(LTRIM(RTRIM(agent))) LIKE 'A-%'
  AND TRY_CAST(SUBSTRING(LTRIM(RTRIM(agent)), 3, 20) AS INT) IS NOT NULL;</property>
