  <Kpis>
    <Kpi dwd:design-time-name="378d1570-7f25-4366-8baf-c35e7b7f1e3a">
      <ID>KPI</ID>
      <Name>Cancellation Rate</Name>
      <AssociatedMeasureGroupID>Fact Booking</AssociatedMeasureGroupID>
      <Value>[Measures].[Previous Cancellations] / [Measures].[Fact Booking Count]</Value>
      <Goal>0.05</Goal>
      <Status>IIF([Measures].[Previous Cancellations] / [Measures].[Fact Booking Count] &lt;= 0.05, 1, -1)</Status>
      <Trend>IIF(
    [Measures].[Previous Cancellations] / [Measures].[Fact Booking Count] &lt;= 0.05,
    1,
    -1
)</Trend>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Gauge - Ascending</StatusGraphic>
    </Kpi>
  </Kpis>
